{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wisp",
  "mainBinaryName": "Wisp",
  "version": "0.1.0",
  "identifier": "io.github.wl-lankin.wisp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "publisher": "Wolfgang Linz",
    "category": "Utility",
    "shortDescription": "Share your clipboard and files between your computers",
    "longDescription": "Wisp shares clipboard content and files between the computers on your home network. Peer to peer, encrypted, no cloud.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/hooks.nsh",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
